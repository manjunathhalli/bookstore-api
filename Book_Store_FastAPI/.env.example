# ---- Application ----
APP_NAME="Book Store"
SECRET_KEY="change-me-to-a-long-random-string"
# Minutes a JWT / password-reset token stays valid
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---- Database (MySQL via XAMPP) ----
# Points at the same schema the Laravel app uses by default.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=book_store_product
DB_USERNAME=root
DB_PASSWORD=

# Create any missing tables on startup (handy for a fresh database).
CREATE_TABLES=true

# ---- AI provider (drives ALL text AI features + both chatbots) ----
# AI_PROVIDER selects the LLM backend for every text feature (sentiment,
# moderation, descriptions, summaries, search, recommendations, tagging,
# forecast, RAG chatbot) and the chatbot agent:
#   groq       -> FREE, OpenAI-compatible. Get a key at
#                 https://console.groq.com/keys and set GROQ_API_KEY below.
#   anthropic  -> Anthropic Claude (paid). Uses ANTHROPIC_* below.
#   ollama     -> FREE, local, key-less. Install Ollama (https://ollama.com),
#                 run `ollama pull qwen2.5`, then leave the OLLAMA_* below as-is.
# Embeddings (Semantic Search) always run locally and ignore this setting.
AI_PROVIDER=groq

# --- Groq (free default) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MODEL_FAST=llama-3.1-8b-instant

# --- Ollama (local, key-less) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5
OLLAMA_MODEL_FAST=qwen2.5

# --- Anthropic (only used when AI_PROVIDER=anthropic) ---
# Get a key at https://console.anthropic.com (API credits, NOT a Claude.ai
# chat subscription).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001

# ---- Embeddings (Semantic Search) ----
# No API key needed: embeddings run on a local sentence-transformers model
# (Anthropic has no embeddings API). Install it via requirements.txt; if it
# is absent, only Semantic Search is disabled. The retired Voyage AI keys
# below are no longer read — kept commented for reference.
# VOYAGE_API_KEY=
# VOYAGE_MODEL=voyage-3

# ---- Business Central RAG chatbot (separate from BookBot) ----
# A second chatbot that ingests Microsoft Dynamics 365 Business Central records
# into a Qdrant vector DB and answers questions grounded in those vectors.
# It reuses AI_PROVIDER above for the LLM and the local embedding model above
# for vectors. Leave the BC_* keys blank to test the full pipeline against
# bundled SAMPLE data (no Business Central subscription required).
#
# Real data: register an Azure AD app (client-credentials), grant it the
# Dynamics 365 Business Central API permission, then fill these in:
BC_TENANT_ID=
BC_CLIENT_ID=
BC_CLIENT_SECRET=
BC_ENVIRONMENT=Production
BC_MAX_RECORDS=500

# Which BC API surface to call:
#   api   -> standard REST API:  .../api/v2.0/companies({guid})/{entity}
#            BC_COMPANY = display name (blank -> first company);
#            BC_ENTITIES = standard entities (items, customers, salesOrders...).
#   odata -> OData V4 web services:  .../ODataV4/Company('{name}')/{service}
#            BC_COMPANY = the company NAME (required);
#            BC_ENTITIES = published web service / page names.
BC_API_STYLE=api

# Company: display name (api) or exact company name (odata):
BC_COMPANY=

# Entities to ingest (comma-separated; all fields of each record are vectorised).
# For OData, use your published service names, e.g.:
#   BC_ENTITIES=Item_Ledger_Entries_Excel,Sales_Orders,Customer_List
BC_ENTITIES=items,customers,salesOrders

# Optional OData $filter applied to every OData fetch (raw OData syntax), e.g.
#   BC_ODATA_FILTER=Posting_Date gt 2026-01-01
BC_ODATA_FILTER=

# ---- Qdrant vector database ----
# EMBEDDED (default): no server needed — vectors persist to the QDRANT_PATH
#   folder below. This is the zero-setup option (used when QDRANT_PATH is set).
# SERVER: to use a Qdrant server instead, leave QDRANT_PATH blank and set
#   QDRANT_URL (local Docker: docker run -p 6333:6333 qdrant/qdrant, or a
#   Qdrant Cloud URL + QDRANT_API_KEY).
QDRANT_PATH=./qdrant_storage
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=business_central

# ---- Redis (cache) ----
# Caches the book catalogue so repeat reads skip the database.
# Run locally with Docker: docker run -p 6379:6379 redis:7-alpine
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_SECONDS=60

# ---- Celery (background jobs) ----
# Reuses the Redis above as both broker and result backend, on separate
# logical DB numbers so cached pages and task state never collide.
CELERY_BROKER_DB=1
CELERY_RESULT_DB=2
